{
  "name": "torflix",
  "version": "0.1.0",
  "description": "Stream torrents straight into MPV / VLC from the command line.",
  "type": "module",
  "bin": {
    "torflix": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "torrent",
    "stream",
    "mpv",
    "vlc",
    "webtorrent",
    "cli",
    "movies",
    "anime"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "kleur": "^4.1.5",
    "ora": "^8.1.1",
    "pretty-bytes": "^6.1.1",
    "torrent-search-api": "^2.1.4",
    "webtorrent": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/webtorrent": "^0.110.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
